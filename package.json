    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@types/node": "^16.18.126",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@typescript-eslint/utils": "^8.54.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.17.3",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "obsidian": "^1.11.4",
    "tslib": "^2.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0"
  }
