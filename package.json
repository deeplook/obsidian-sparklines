{
  "name": "sparkline",
  "version": "1.0.0",
  "description": "Obsidian plugin for inline sparkline SVGs",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
